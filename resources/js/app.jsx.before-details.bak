import React, { useEffect, useState } from 'react';
import { createRoot } from 'react-dom/client';

const money = (value) =>
    new Intl.NumberFormat('fr-MA').format(Number(value));

function PropertyImage({ src, alt, ...props }) {
    return (
        <img
            {...props}
            src={src || '/images/villa-marrakech.jpg'}
            alt={alt}
            onError={(event) => {
                event.currentTarget.onerror = null;
                event.currentTarget.src = '/images/villa-marrakech.jpg';
            }}
        />
    );
}

function App() {
    const [properties, setProperties] = useState([]);
    const [loading, setLoading] = useState(true);
    const [loadError, setLoadError] = useState('');

    const [transaction, setTransaction] = useState('Vente');
    const [city, setCity] = useState('');
    const [type, setType] = useState('');
    const [budget, setBudget] = useState('');
    const [filters, setFilters] = useState(null);

    const [favorites, setFavorites] = useState([]);
    const [favoritesOnly, setFavoritesOnly] = useState(false);

    useEffect(() => {
        const controller = new AbortController();

        async function loadProperties() {
            try {
                const response = await fetch('/properties-data', {
                    headers: {
                        Accept: 'application/json',
                    },
                    signal: controller.signal,
                });

                if (!response.ok) {
                    throw new Error('Chargement impossible.');
                }

                const data = await response.json();

                if (!Array.isArray(data)) {
                    throw new Error('Réponse invalide.');
                }

                setProperties(data);
            } catch (error) {
                if (error.name !== 'AbortError') {
                    setLoadError(
                        'Impossible de charger les biens. Vérifiez que Laravel et MySQL sont démarrés, puis actualisez la page.'
                    );
                }
            } finally {
                if (!controller.signal.aborted) {
                    setLoading(false);
                }
            }
        }

        loadProperties();

        return () => controller.abort();
    }, []);

    const cities = [...new Set(properties.map((item) => item.city))]
        .filter(Boolean)
        .sort();

    const types = [...new Set(properties.map((item) => item.type))]
        .filter(Boolean)
        .sort();

    function toggleFavorite(id) {
        setFavorites((previous) =>
            previous.includes(id)
                ? previous.filter((item) => item !== id)
                : [...previous, id]
        );
    }

    function search(event) {
        event.preventDefault();

        setFilters({
            transaction,
            city,
            type,
            budget,
        });

        setFavoritesOnly(false);

        document.getElementById('biens')?.scrollIntoView({
            behavior: 'smooth',
        });
    }

    function resetFilters() {
        setTransaction('Vente');
        setCity('');
        setType('');
        setBudget('');
        setFilters(null);
        setFavoritesOnly(false);
    }

    const visibleProperties = properties.filter((property) => {
        if (favoritesOnly && !favorites.includes(property.id)) {
            return false;
        }

        if (!filters) {
            return true;
        }

        return (
            property.transaction === filters.transaction &&
            (!filters.city || property.city === filters.city) &&
            (!filters.type || property.type === filters.type) &&
            (!filters.budget ||
                Number(property.price) <= Number(filters.budget))
        );
    });

    return (
        <>
            <style>{`
                * {
                    box-sizing: border-box;
                }

                html {
                    scroll-behavior: smooth;
                }

                body {
                    margin: 0;
                    font-family: Arial, sans-serif;
                    background: #faf9f6;
                    color: #203a33;
                }

                button, input, select {
                    font: inherit;
                }

                button {
                    cursor: pointer;
                }

                button:disabled {
                    opacity: .6;
                    cursor: wait;
                }

                a {
                    text-decoration: none;
                    color: inherit;
                }

                button:focus-visible,
                a:focus-visible,
                input:focus-visible,
                select:focus-visible {
                    outline: 3px solid #c29861;
                    outline-offset: 4px;
                }

                .container {
                    max-width: 1180px;
                    margin: auto;
                    padding: 0 28px;
                }

                .header {
                    min-height: 88px;
                    display: flex;
                    align-items: center;
                    justify-content: space-between;
                    gap: 24px;
                }

                .logo {
                    font-size: 25px;
                    font-weight: 800;
                    letter-spacing: -1px;
                }

                .logo span {
                    color: #b48a55;
                }

                .nav {
                    display: flex;
                    align-items: center;
                    gap: 28px;
                    font-size: 14px;
                }

                .nav a:hover {
                    color: #a67c48;
                }

                .button {
                    display: inline-flex;
                    align-items: center;
                    justify-content: center;
                    padding: 15px 23px;
                    border: 0;
                    border-radius: 7px;
                    background: #244b3e;
                    color: white;
                    font-weight: 600;
                }

                .button:hover {
                    background: #17392d;
                    color: white;
                }

                .hero {
                    display: grid;
                    grid-template-columns: 1fr 1fr;
                    align-items: center;
                    gap: 55px;
                    padding: 65px 0 100px;
                }

                .eyebrow {
                    color: #947044;
                    text-transform: uppercase;
                    letter-spacing: 3px;
                    font-size: 11px;
                    font-weight: 700;
                }

                h1, h2, h3, p {
                    margin-top: 0;
                }

                h1 {
                    font-family: Georgia, serif;
                    font-size: clamp(42px, 5vw, 66px);
                    font-weight: 400;
                    line-height: 1.08;
                    margin-bottom: 24px;
                }

                h1 em {
                    color: #a27c4c;
                    font-weight: 400;
                }

                .intro {
                    color: #758078;
                    line-height: 1.9;
                    max-width: 440px;
                }

                .hero-actions {
                    display: flex;
                    align-items: center;
                    gap: 25px;
                    margin-top: 30px;
                }

                .text-link {
                    font-size: 14px;
                    border-bottom: 1px solid #aab5ad;
                    padding-bottom: 5px;
                }

                .hero-art {
                    position: relative;
                    height: 390px;
                    border-radius: 100px 12px 12px 12px;
                    overflow: hidden;
                    background: #ded8cc;
                }

                .hero-art img {
                    height: 100%;
                    width: 100%;
                    object-fit: cover;
                    display: block;
                }

                .art-label {
                    position: absolute;
                    bottom: 22px;
                    left: 22px;
                    right: 22px;
                    width: fit-content;
                    background: #fffffff0;
                    padding: 16px 22px;
                    border-radius: 8px;
                }

                .art-label strong {
                    display: block;
                    margin-bottom: 6px;
                }

                .art-label small {
                    color: #758078;
                }

                .search-panel {
                    margin-top: -45px;
                    position: relative;
                    background: white;
                    padding: 25px;
                    border-radius: 12px;
                    box-shadow: 0 15px 55px #203a330c;
                    border: 1px solid #eeece6;
                }

                .tabs {
                    display: flex;
                    gap: 8px;
                    margin-bottom: 22px;
                }

                .tab {
                    padding: 10px 24px;
                    border: 0;
                    background: #f4f4ef;
                    color: #5b6b60;
                    border-radius: 5px;
                }

                .tab.active {
                    background: #244b3e;
                    color: white;
                }

                .search-grid {
                    display: grid;
                    grid-template-columns: 1fr 1fr 1fr auto;
                    align-items: end;
                    gap: 18px;
                }

                label {
                    display: block;
                    font-size: 12px;
                    font-weight: 700;
                }

                select, input {
                    width: 100%;
                    margin-top: 9px;
                    padding: 13px;
                    border: 1px solid #e2e6df;
                    border-radius: 5px;
                    color: #536259;
                    background: white;
                    min-width: 0;
                }

                .section {
                    padding: 80px 0;
                    scroll-margin-top: 25px;
                }

                .section-heading {
                    display: flex;
                    justify-content: space-between;
                    align-items: end;
                    gap: 20px;
                    margin-bottom: 30px;
                }

                h2 {
                    font-family: Georgia, serif;
                    font-size: 36px;
                    font-weight: 400;
                    margin-bottom: 12px;
                }

                .muted {
                    color: #7b857d;
                    font-size: 14px;
                    line-height: 1.8;
                    margin-bottom: 0;
                }

                .outline {
                    padding: 12px 18px;
                    border: 1px solid #d7ded5;
                    border-radius: 6px;
                    background: transparent;
                    color: #244b3e;
                }

                .outline:hover,
                .outline.selected {
                    background: #e6eee8;
                    border-color: #244b3e;
                }

                .filter-actions {
                    display: flex;
                    flex-wrap: wrap;
                    gap: 10px;
                }

                .cards {
                    display: grid;
                    grid-template-columns: repeat(3, 1fr);
                    gap: 25px;
                }

                .card {
                    background: white;
                    border: 1px solid #e8eae3;
                    border-radius: 10px;
                    overflow: hidden;
                    transition: transform .2s, box-shadow .2s;
                }

                .card:hover {
                    transform: translateY(-4px);
                    box-shadow: 0 14px 30px #203a3310;
                }

                .card-image {
                    position: relative;
                    height: 215px;
                    overflow: hidden;
                    background: #e7e7df;
                }

                .card-image img {
                    width: 100%;
                    height: 100%;
                    object-fit: cover;
                    display: block;
                    transition: transform .4s;
                }

                .card:hover .card-image img {
                    transform: scale(1.04);
                }

                .badge {
                    position: absolute;
                    top: 15px;
                    left: 15px;
                    background: white;
                    padding: 7px 11px;
                    border-radius: 4px;
                    font-size: 11px;
                    font-weight: 700;
                }

                .favorite {
                    position: absolute;
                    top: 13px;
                    right: 13px;
                    width: 36px;
                    height: 36px;
                    border: 0;
                    border-radius: 50%;
                    background: white;
                    color: #244b3e;
                    font-size: 24px;
                }

                .favorite.saved {
                    color: #b65b58;
                }

                .card-body {
                    padding: 22px;
                }

                .price {
                    color: #244b3e;
                    font-size: 21px;
                    font-weight: 700;
                    margin-bottom: 14px;
                }

                .price small {
                    font-weight: 400;
                    font-size: 12px;
                    color: #7b857d;
                }

                h3 {
                    font-size: 17px;
                    margin-bottom: 9px;
                }

                .location {
                    font-size: 12px;
                    color: #7b857d;
                    margin-bottom: 20px;
                }

                .features {
                    border-top: 1px solid #eef0e9;
                    padding-top: 15px;
                    display: flex;
                    flex-wrap: wrap;
                    gap: 15px;
                    font-size: 12px;
                    color: #68766c;
                }

                .demo-note {
                    margin-top: 22px;
                    font-size: 12px;
                    color: #7b857d;
                    line-height: 1.8;
                }

                .empty {
                    padding: 45px 25px;
                    text-align: center;
                    border: 1px dashed #cbd4c8;
                    border-radius: 8px;
                    line-height: 1.8;
                }

                .error {
                    border-color: #dba9a3;
                    color: #99483f;
                    background: #fff5f2;
                }

                .about {
                    display: grid;
                    grid-template-columns: 1fr 1fr;
                    gap: 65px;
                    background: #edf0e8;
                    border-radius: 12px;
                    padding: 50px;
                }

                .about p {
                    color: #68766c;
                    line-height: 1.9;
                }

                .reasons {
                    display: grid;
                    gap: 22px;
                    align-content: center;
                }

                .reason {
                    display: flex;
                    gap: 15px;
                    align-items: start;
                }

                .number {
                    color: #a27c4c;
                    font-family: Georgia, serif;
                    font-size: 26px;
                }

                .reason strong {
                    display: block;
                    margin-bottom: 5px;
                }

                .reason p {
                    margin: 0;
                    font-size: 13px;
                }

                .contact {
                    margin-top: 65px;
                    margin-bottom: 60px;
                    padding: 40px;
                    border-radius: 12px;
                    background: #244b3e;
                    color: white;
                    display: flex;
                    align-items: center;
                    justify-content: space-between;
                    gap: 25px;
                }

                .contact h2 {
                    font-size: 30px;
                }

                .contact p {
                    color: #d0ddd3;
                    margin-bottom: 0;
                    line-height: 1.7;
                }

                .contact-tag {
                    padding: 14px 20px;
                    border: 1px solid #6e8a78;
                    border-radius: 6px;
                    font-size: 13px;
                    flex-shrink: 0;
                }

                footer {
                    padding: 30px 0;
                    border-top: 1px solid #e4e7df;
                    display: flex;
                    justify-content: space-between;
                    align-items: center;
                    gap: 15px;
                }

                footer p {
                    color: #7b857d;
                    font-size: 12px;
                    margin: 0;
                }

                @media (max-width: 900px) {
                    .nav { gap: 15px; }
                    .hero { gap: 25px; }
                    .hero-art { height: 340px; }
                    .search-grid { grid-template-columns: 1fr 1fr; }
                    .cards { grid-template-columns: repeat(2, 1fr); }
                    .about { gap: 30px; padding: 30px; }
                }

                @media (max-width: 600px) {
                    .container { padding: 0 20px; }
                    .header {
                        flex-wrap: wrap;
                        padding: 22px 0;
                        gap: 18px;
                    }
                    .nav {
                        width: 100%;
                        justify-content: space-between;
                        font-size: 12px;
                        gap: 10px;
                    }
                    .nav .button { padding: 10px 12px; }
                    .hero {
                        grid-template-columns: 1fr;
                        padding: 35px 0 75px;
                        gap: 35px;
                    }
                    h1 { font-size: 45px; }
                    .hero-actions { gap: 18px; }
                    .hero-art {
                        height: 280px;
                        border-top-left-radius: 65px;
                    }
                    .search-panel { padding: 20px; }
                    .search-grid, .cards, .about {
                        grid-template-columns: 1fr;
                    }
                    .section { padding: 55px 0; }
                    .section-heading {
                        align-items: start;
                        flex-direction: column;
                    }
                    h2 { font-size: 30px; }
                    .card-image { height: 230px; }
                    .about { padding: 25px; }
                    .contact {
                        padding: 28px;
                        flex-direction: column;
                        align-items: start;
                    }
                    footer {
                        align-items: start;
                        flex-direction: column;
                    }
                }

                @media (prefers-reduced-motion: reduce) {
                    html { scroll-behavior: auto; }
                    .card, .card-image img { transition: none; }
                }
            `}</style>

            <div className="container">
                <header className="header" id="accueil">
                    <a href="#accueil" className="logo">
                        Immo<span>Space.</span>
                    </a>

                    <nav className="nav" aria-label="Navigation principale">
                        <a href="#accueil">Accueil</a>
                        <a href="#biens">Nos biens</a>
                        <a href="#agence">L’agence</a>
                        <a href="#contact" className="button">
                            Contact
                        </a>
                    </nav>
                </header>

                <main>
                    <section className="hero">
                        <div>
                            <p className="eyebrow">
                                Un lieu. Une vie. Une histoire.
                            </p>

                            <h1>
                                Trouvez votre
                                <br />
                                <em>nouveau chez-vous.</em>
                            </h1>

                            <p className="intro">
                                Acheter ou louer, chaque projet mérite une
                                attention particulière. Découvrez des biens
                                à la hauteur de vos envies.
                            </p>

                            <div className="hero-actions">
                                <a href="#biens" className="button">
                                    Découvrir nos biens ↗
                                </a>

                                <a href="#agence" className="text-link">
                                    Notre agence
                                </a>
                            </div>
                        </div>

                        <div className="hero-art">
                            <PropertyImage
                                src="/images/villa-marrakech.jpg"
                                alt="Villa avec piscine, photographie illustrative"
                            />

                            <div className="art-label">
                                <strong>Votre prochaine adresse</strong>
                                <small>Marrakech · Casablanca · Rabat</small>
                            </div>
                        </div>
                    </section>

                    <form className="search-panel" onSubmit={search}>
                        <div className="tabs">
                            {['Vente', 'Location'].map((item) => (
                                <button
                                    key={item}
                                    type="button"
                                    className={`tab ${
                                        transaction === item ? 'active' : ''
                                    }`}
                                    aria-pressed={transaction === item}
                                    onClick={() => setTransaction(item)}
                                >
                                    {item === 'Vente' ? 'Acheter' : 'Louer'}
                                </button>
                            ))}
                        </div>

                        <div className="search-grid">
                            <label>
                                Ville
                                <select
                                    value={city}
                                    onChange={(event) =>
                                        setCity(event.target.value)
                                    }
                                >
                                    <option value="">Toutes les villes</option>
                                    {cities.map((item) => (
                                        <option key={item} value={item}>
                                            {item}
                                        </option>
                                    ))}
                                </select>
                            </label>

                            <label>
                                Type de bien
                                <select
                                    value={type}
                                    onChange={(event) =>
                                        setType(event.target.value)
                                    }
                                >
                                    <option value="">Tous les types</option>
                                    {types.map((item) => (
                                        <option key={item} value={item}>
                                            {item}
                                        </option>
                                    ))}
                                </select>
                            </label>

                            <label>
                                Budget maximum{' '}
                                {transaction === 'Location'
                                    ? '(DH/mois)'
                                    : '(DH)'}

                                <input
                                    type="number"
                                    min="0"
                                    step="any"
                                    placeholder="Sans limite"
                                    value={budget}
                                    onChange={(event) =>
                                        setBudget(event.target.value)
                                    }
                                />
                            </label>

                            <button
                                className="button"
                                type="submit"
                                disabled={loading || Boolean(loadError)}
                            >
                                Rechercher ↗
                            </button>
                        </div>
                    </form>

                    <section className="section" id="biens">
                        <div className="section-heading">
                            <div>
                                <p className="eyebrow">Notre sélection</p>

                                <h2>
                                    {favoritesOnly
                                        ? 'Vos coups de cœur'
                                        : 'Des lieux à découvrir'}
                                </h2>

                                {!loading && !loadError && (
                                    <p className="muted" aria-live="polite">
                                        {visibleProperties.length} bien(s)
                                        affiché(s)
                                        {filters
                                            ? ' selon vos critères.'
                                            : '.'}
                                    </p>
                                )}
                            </div>

                            <div className="filter-actions">
                                {filters && (
                                    <button
                                        type="button"
                                        className="outline"
                                        onClick={resetFilters}
                                    >
                                        Réinitialiser
                                    </button>
                                )}

                                <button
                                    type="button"
                                    className={`outline ${
                                        favoritesOnly ? 'selected' : ''
                                    }`}
                                    aria-pressed={favoritesOnly}
                                    onClick={() =>
                                        setFavoritesOnly(!favoritesOnly)
                                    }
                                >
                                    {favoritesOnly
                                        ? 'Voir les résultats'
                                        : `♡ Mes favoris (${favorites.length})`}
                                </button>
                            </div>
                        </div>

                        {loading ? (
                            <div className="empty" role="status">
                                Chargement des biens…
                            </div>
                        ) : loadError ? (
                            <div className="empty error" role="alert">
                                <p>{loadError}</p>
                                <button
                                    type="button"
                                    className="outline"
                                    onClick={() => window.location.reload()}
                                >
                                    Réessayer
                                </button>
                            </div>
                        ) : visibleProperties.length > 0 ? (
                            <div className="cards">
                                {visibleProperties.map((property) => {
                                    const isFavorite =
                                        favorites.includes(property.id);

                                    return (
                                        <article
                                            className="card"
                                            key={property.id}
                                        >
                                            <div className="card-image">
                                                <PropertyImage
                                                    src={property.image}
                                                    alt={property.title}
                                                    loading="lazy"
                                                />

                                                <span className="badge">
                                                    {property.transaction ===
                                                    'Vente'
                                                        ? 'À vendre'
                                                        : 'À louer'}
                                                </span>

                                                <button
                                                    type="button"
                                                    className={`favorite ${
                                                        isFavorite
                                                            ? 'saved'
                                                            : ''
                                                    }`}
                                                    onClick={() =>
                                                        toggleFavorite(
                                                            property.id
                                                        )
                                                    }
                                                    aria-label={`${
                                                        isFavorite
                                                            ? 'Retirer des'
                                                            : 'Ajouter aux'
                                                    } favoris : ${
                                                        property.title
                                                    }`}
                                                    aria-pressed={isFavorite}
                                                >
                                                    {isFavorite ? '♥' : '♡'}
                                                </button>
                                            </div>

                                            <div className="card-body">
                                                <p className="price">
                                                    {money(property.price)} DH
                                                    {property.transaction ===
                                                        'Location' && (
                                                        <small> / mois</small>
                                                    )}
                                                </p>

                                                <h3>{property.title}</h3>

                                                <p className="location">
                                                    {property.city}
                                                    {property.district &&
                                                        ` · ${property.district}`}
                                                </p>

                                                <div className="features">
                                                    <span>
                                                        {property.area} m²
                                                    </span>

                                                    {Number(
                                                        property.bedrooms
                                                    ) > 0 && (
                                                        <span>
                                                            {property.bedrooms}{' '}
                                                            chambre(s)
                                                        </span>
                                                    )}

                                                    <span>{property.type}</span>
                                                </div>
                                            </div>
                                        </article>
                                    );
                                })}
                            </div>
                        ) : (
                            <div className="empty">
                                <p>
                                    {favoritesOnly
                                        ? 'Aucun favori ne correspond à cette sélection.'
                                        : 'Aucun bien ne correspond à votre recherche.'}
                                </p>

                                <button
                                    type="button"
                                    className="outline"
                                    onClick={resetFilters}
                                >
                                    Afficher tous les biens
                                </button>
                            </div>
                        )}

                        <p className="demo-note">
                            Projet de démonstration : annonces fictives et
                            photos d’illustration. Les favoris sont conservés
                            uniquement pendant cette visite.
                        </p>
                    </section>

                    <section id="agence" className="about">
                        <div>
                            <p className="eyebrow">L’esprit ImmoSpace</p>

                            <h2>
                                Votre projet immobilier,
                                <br />
                                en toute simplicité.
                            </h2>

                            <p>
                                Nous imaginons une expérience immobilière
                                plus claire, plus humaine et plus proche de
                                vos besoins. Du premier échange à la découverte
                                de votre futur lieu de vie.
                            </p>

                            <a href="#contact" className="text-link">
                                Parlons de votre projet ↗
                            </a>
                        </div>

                        <div className="reasons">
                            <div className="reason">
                                <span className="number">01</span>
                                <div>
                                    <strong>Une sélection adaptée</strong>
                                    <p>
                                        Des biens à explorer selon votre budget
                                        et votre mode de vie.
                                    </p>
                                </div>
                            </div>

                            <div className="reason">
                                <span className="number">02</span>
                                <div>
                                    <strong>Des informations claires</strong>
                                    <p>
                                        Les caractéristiques essentielles
                                        réunies au même endroit.
                                    </p>
                                </div>
                            </div>

                            <div className="reason">
                                <span className="number">03</span>
                                <div>
                                    <strong>
                                        Un accompagnement personnel
                                    </strong>
                                    <p>
                                        Un espace pensé pour faciliter
                                        vos prochaines démarches.
                                    </p>
                                </div>
                            </div>
                        </div>
                    </section>

                    <section className="contact" id="contact">
                        <div>
                            <h2>
                                Une nouvelle adresse commence ici.
                            </h2>
                            <p>
                                L’espace de contact sera disponible
                                prochainement pour organiser vos visites.
                            </p>
                        </div>

                        <span className="contact-tag">
                            Projet en développement
                        </span>
                    </section>
                </main>

                <footer>
                    <a href="#accueil" className="logo">
                        Immo<span>Space.</span>
                    </a>

                    <p>
                        © {new Date().getFullYear()} ImmoSpace ·
                        Projet réalisé par Inass Silbi
                    </p>
                </footer>
            </div>
        </>
    );
}

createRoot(document.getElementById('app')).render(<App />);
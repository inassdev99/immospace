import React, { useState } from 'react';
import { createRoot } from 'react-dom/client';

const properties = [
    {
        id: 1,
        title: 'Villa avec piscine',
        city: 'Marrakech',
        district: 'Route de l’Ourika',
        type: 'Villa',
        transaction: 'Vente',
        price: 3200000,
        area: 320,
        bedrooms: 4,
        color: '#c9b69a',
    },
    {
        id: 2,
        title: 'Appartement lumineux',
        city: 'Marrakech',
        district: 'Guéliz',
        type: 'Appartement',
        transaction: 'Location',
        price: 6500,
        area: 95,
        bedrooms: 2,
        color: '#a8b9b0',
    },
    {
        id: 3,
        title: 'Maison avec jardin',
        city: 'Casablanca',
        district: 'Californie',
        type: 'Maison',
        transaction: 'Vente',
        price: 2450000,
        area: 210,
        bedrooms: 3,
        color: '#b6b5c6',
    },
    {
        id: 4,
        title: 'Appartement contemporain',
        city: 'Rabat',
        district: 'Agdal',
        type: 'Appartement',
        transaction: 'Vente',
        price: 1250000,
        area: 85,
        bedrooms: 2,
        color: '#d0b4a5',
    },
    {
        id: 5,
        title: 'Villa familiale',
        city: 'Marrakech',
        district: 'Targa',
        type: 'Villa',
        transaction: 'Location',
        price: 18000,
        area: 280,
        bedrooms: 4,
        color: '#b9c1a3',
    },
    {
        id: 6,
        title: 'Maison au calme',
        city: 'Rabat',
        district: 'Hay Riad',
        type: 'Maison',
        transaction: 'Location',
        price: 12000,
        area: 180,
        bedrooms: 3,
        color: '#a9bdc5',
    },
];

const money = (value) => new Intl.NumberFormat('fr-MA').format(value);

function HouseIllustration({ color = '#c9b69a' }) {
    return (
        <svg
            viewBox="0 0 600 360"
            role="img"
            aria-label="Illustration d’une propriété"
            width="100%"
            height="100%"
            preserveAspectRatio="xMidYMid slice"
        >
            <rect width="600" height="360" fill={color} />
            <circle cx="470" cy="76" r="38" fill="#fff4d5" opacity=".8" />
            <path d="M0 270 Q150 210 320 280 T600 250 V360 H0Z" fill="#718475" />
            <rect x="135" y="135" width="330" height="160" fill="#f4ede2" />
            <rect x="110" y="118" width="380" height="24" fill="#e0d5c4" />
            <rect x="160" y="165" width="110" height="95" fill="#476364" />
            <rect x="290" y="165" width="145" height="95" fill="#476364" />
            <path d="M215 165 V260 M362 165 V260" stroke="#f4ede2" strokeWidth="7" />
            <path d="M160 175 L265 250 M300 175 L425 250" stroke="#fff" opacity=".12" strokeWidth="14" />
            <rect x="120" y="290" width="360" height="12" fill="#d6c8b5" />
            <ellipse cx="490" cy="300" rx="45" ry="12" fill="#536e58" />
            <rect x="486" y="182" width="8" height="110" fill="#77634e" />
            <circle cx="490" cy="175" r="43" fill="#56725c" />
            <rect x="90" y="320" width="330" height="18" rx="9" fill="#a8d1cb" />
        </svg>
    );
}

function App() {
    const [transaction, setTransaction] = useState('Vente');
    const [city, setCity] = useState('');
    const [type, setType] = useState('');
    const [budget, setBudget] = useState('');
    const [filters, setFilters] = useState(null);
    const [favorites, setFavorites] = useState([]);
    const [favoritesOnly, setFavoritesOnly] = useState(false);

    function toggleFavorite(id) {
        setFavorites((previous) =>
            previous.includes(id)
                ? previous.filter((item) => item !== id)
                : [...previous, id]
        );
    }

    function search(event) {
        event.preventDefault();
        setFilters({ transaction, city, type, budget });
        setFavoritesOnly(false);
        document.getElementById('biens')?.scrollIntoView({ behavior: 'smooth' });
    }

    const visibleProperties = properties.filter((property) => {
        if (favoritesOnly && !favorites.includes(property.id)) return false;
        if (!filters) return true;

        return (
            property.transaction === filters.transaction &&
            (!filters.city || property.city === filters.city) &&
            (!filters.type || property.type === filters.type) &&
            (!filters.budget || property.price <= Number(filters.budget))
        );
    });

    return (
        <>
            <style>{`
                * { box-sizing: border-box; }
                html { scroll-behavior: smooth; }
                body {
                    margin: 0;
                    font-family: Arial, sans-serif;
                    background: #faf9f6;
                    color: #203a33;
                }
                button, input, select { font: inherit; }
                button, a, select { -webkit-tap-highlight-color: transparent; }
                button { cursor: pointer; }
                a { text-decoration: none; color: inherit; }
                button:focus-visible, a:focus-visible,
                input:focus-visible, select:focus-visible {
                    outline: 3px solid #c29861;
                    outline-offset: 4px;
                }
                .container { max-width: 1180px; margin: auto; padding: 0 28px; }
                .header {
                    min-height: 88px; display: flex; align-items: center;
                    justify-content: space-between; gap: 24px;
                }
                .logo { font-size: 25px; font-weight: 800; letter-spacing: -1px; }
                .logo span { color: #b48a55; }
                .nav { display: flex; align-items: center; gap: 28px; font-size: 14px; }
                .nav a:hover { color: #a67c48; }
                .button {
                    display: inline-flex; align-items: center; justify-content: center;
                    padding: 15px 23px; border: 0; border-radius: 7px;
                    background: #244b3e; color: white; font-weight: 600;
                }
                .button:hover { background: #17392d; }
                .hero {
                    display: grid; grid-template-columns: 1fr 1fr;
                    align-items: center; gap: 55px; padding: 65px 0 100px;
                }
                .eyebrow {
                    color: #947044; text-transform: uppercase;
                    letter-spacing: 3px; font-size: 11px; font-weight: 700;
                }
                h1, h2, h3, p { margin-top: 0; }
                h1 {
                    font-family: Georgia, serif; font-size: clamp(42px, 5vw, 66px);
                    font-weight: 400; line-height: 1.08; margin-bottom: 24px;
                }
                h1 em { color: #a27c4c; font-weight: 400; }
                .intro { color: #758078; line-height: 1.9; max-width: 440px; }
                .hero-actions { display: flex; align-items: center; gap: 25px; margin-top: 30px; }
                .text-link { font-size: 14px; border-bottom: 1px solid #aab5ad; padding-bottom: 5px; }
                .hero-art {
                    position: relative; height: 390px;
                    border-radius: 100px 12px 12px 12px; overflow: hidden;
                }
                .hero-art svg { height: 100%; }
                .art-label {
                    position: absolute; bottom: 22px; left: 22px;
                    background: #fffffff0; padding: 16px 22px; border-radius: 8px;
                }
                .art-label strong { display: block; margin-bottom: 6px; }
                .art-label small { color: #758078; }
                .search-panel {
                    margin-top: -45px; position: relative; background: white;
                    padding: 25px; border-radius: 12px;
                    box-shadow: 0 15px 55px #203a330c;
                    border: 1px solid #eeece6;
                }
                .tabs { display: flex; gap: 8px; margin-bottom: 22px; }
                .tab {
                    padding: 10px 24px; border: 0; background: #f4f4ef;
                    color: #5b6b60; border-radius: 5px;
                }
                .tab.active { background: #244b3e; color: white; }
                .search-grid {
                    display: grid; grid-template-columns: 1fr 1fr 1fr auto;
                    align-items: end; gap: 18px;
                }
                label { display: block; font-size: 12px; font-weight: 700; }
                select, input {
                    width: 100%; margin-top: 9px; padding: 13px;
                    border: 1px solid #e2e6df; border-radius: 5px;
                    color: #536259; background: white; min-width: 0;
                }
                .section { padding: 80px 0; }
                .section-heading {
                    display: flex; justify-content: space-between;
                    align-items: end; gap: 20px; margin-bottom: 30px;
                }
                h2 { font-family: Georgia, serif; font-size: 36px; font-weight: 400; margin-bottom: 12px; }
                .muted { color: #7b857d; font-size: 14px; line-height: 1.8; margin-bottom: 0; }
                .outline {
                    padding: 12px 18px; border: 1px solid #d7ded5;
                    border-radius: 6px; background: transparent; color: #244b3e;
                }
                .outline.selected { background: #e6eee8; border-color: #244b3e; }
                .cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: 25px; }
                .card { background: white; border: 1px solid #e8eae3; border-radius: 10px; overflow: hidden; }
                .card-image { position: relative; height: 215px; }
                .badge {
                    position: absolute; top: 15px; left: 15px; background: white;
                    padding: 7px 11px; border-radius: 4px; font-size: 11px; font-weight: 700;
                }
                .favorite {
                    position: absolute; top: 13px; right: 13px; width: 36px;
                    height: 36px; border: 0; border-radius: 50%; background: white;
                    color: #244b3e; font-size: 24px;
                }
                .favorite.saved { color: #b65b58; }
                .card-body { padding: 22px; }
                .price { color: #244b3e; font-size: 21px; font-weight: 700; margin-bottom: 14px; }
                .price small { font-weight: 400; font-size: 12px; color: #7b857d; }
                h3 { font-size: 17px; margin-bottom: 9px; }
                .location { font-size: 12px; color: #7b857d; margin-bottom: 20px; }
                .features {
                    border-top: 1px solid #eef0e9; padding-top: 15px;
                    display: flex; flex-wrap: wrap; gap: 15px; font-size: 12px; color: #68766c;
                }
                .demo-note { margin-top: 22px; font-size: 12px; color: #7b857d; }
                .empty { padding: 45px; text-align: center; border: 1px dashed #cbd4c8; border-radius: 8px; }
                .about {
                    display: grid; grid-template-columns: 1fr 1fr;
                    gap: 65px; background: #edf0e8; border-radius: 12px; padding: 50px;
                }
                .about p { color: #68766c; line-height: 1.9; }
                .reasons { display: grid; gap: 22px; align-content: center; }
                .reason { display: flex; gap: 15px; align-items: start; }
                .number { color: #a27c4c; font-family: Georgia, serif; font-size: 26px; }
                .reason strong { display: block; margin-bottom: 5px; }
                .reason p { margin: 0; font-size: 13px; }
                .contact {
                    margin-top: 65px; padding: 40px; border-radius: 12px;
                    background: #244b3e; color: white;
                    display: flex; align-items: center; justify-content: space-between; gap: 25px;
                }
                .contact h2 { font-size: 30px; }
                .contact p { color: #d0ddd3; margin-bottom: 0; line-height: 1.7; }
                .contact-tag { padding: 14px 20px; border: 1px solid #6e8a78; border-radius: 6px; font-size: 13px; }
                footer {
                    padding: 30px 0; border-top: 1px solid #e4e7df;
                    display: flex; justify-content: space-between; align-items: center; gap: 15px;
                }
                footer p { color: #7b857d; font-size: 12px; margin: 0; }
                @media (max-width: 900px) {
                    .nav { gap: 15px; }
                    .hero { gap: 25px; }
                    .hero-art { height: 340px; }
                    .search-grid { grid-template-columns: 1fr 1fr; }
                    .cards { grid-template-columns: repeat(2, 1fr); }
                    .about { gap: 30px; padding: 30px; }
                }
                @media (max-width: 600px) {
                    .container { padding: 0 20px; }
                    .header { flex-wrap: wrap; padding: 22px 0; gap: 18px; }
                    .nav { width: 100%; justify-content: space-between; font-size: 12px; gap: 10px; }
                    .nav .button { padding: 10px 12px; }
                    .hero { grid-template-columns: 1fr; padding: 35px 0 75px; gap: 35px; }
                    h1 { font-size: 45px; }
                    .hero-art { height: 280px; border-top-left-radius: 65px; }
                    .search-panel { padding: 20px; }
                    .search-grid, .cards, .about { grid-template-columns: 1fr; }
                    .section { padding: 55px 0; }
                    .section-heading { align-items: start; flex-direction: column; }
                    h2 { font-size: 30px; }
                    .card-image { height: 230px; }
                    .about { padding: 25px; }
                    .contact { padding: 28px; flex-direction: column; align-items: start; }
                    footer { align-items: start; flex-direction: column; }
                }
            `}</style>

            <div className="container">
                <header className="header" id="accueil">
                    <a href="#accueil" className="logo">Immo<span>Space.</span></a>

                    <nav className="nav" aria-label="Navigation principale">
                        <a href="#accueil">Accueil</a>
                        <a href="#biens">Nos biens</a>
                        <a href="#agence">L’agence</a>
                        <a href="#contact" className="button">Contact</a>
                    </nav>
                </header>

                <section className="hero">
                    <div>
                        <p className="eyebrow">Un lieu. Une vie. Une histoire.</p>
                        <h1>Trouvez votre<br /><em>nouveau chez-vous.</em></h1>
                        <p className="intro">
                            Acheter ou louer, chaque projet mérite une attention
                            particulière. Découvrez des biens à la hauteur de vos envies.
                        </p>

                        <div className="hero-actions">
                            <a href="#biens" className="button">Découvrir nos biens ↗</a>
                            <a href="#agence" className="text-link">Notre agence</a>
                        </div>
                    </div>

                    <div className="hero-art">
                        <HouseIllustration />
                        <div className="art-label">
                            <strong>Votre prochaine adresse</strong>
                            <small>Marrakech · Casablanca · Rabat</small>
                        </div>
                    </div>
                </section>

                <form className="search-panel" onSubmit={search}>
                    <div className="tabs">
                        {['Vente', 'Location'].map((item) => (
                            <button
                                key={item}
                                type="button"
                                className={`tab ${transaction === item ? 'active' : ''}`}
                                aria-pressed={transaction === item}
                                onClick={() => setTransaction(item)}
                            >
                                {item === 'Vente' ? 'Acheter' : 'Louer'}
                            </button>
                        ))}
                    </div>

                    <div className="search-grid">
                        <label>
                            Ville
                            <select value={city} onChange={(e) => setCity(e.target.value)}>
                                <option value="">Toutes les villes</option>
                                <option>Marrakech</option>
                                <option>Casablanca</option>
                                <option>Rabat</option>
                            </select>
                        </label>

                        <label>
                            Type de bien
                            <select value={type} onChange={(e) => setType(e.target.value)}>
                                <option value="">Tous les types</option>
                                <option>Villa</option>
                                <option>Appartement</option>
                                <option>Maison</option>
                            </select>
                        </label>

                        <label>
                            Budget maximum {transaction === 'Location' ? '(DH/mois)' : '(DH)'}
                            <input
                                type="number"
                                min="0"
                                placeholder="Sans limite"
                                value={budget}
                                onChange={(e) => setBudget(e.target.value)}
                            />
                        </label>

                        <button className="button" type="submit">Rechercher ↗</button>
                    </div>
                </form>

                <section className="section" id="biens">
                    <div className="section-heading">
                        <div>
                            <p className="eyebrow">Notre sélection</p>
                            <h2>{favoritesOnly ? 'Vos coups de cœur' : 'Des lieux à découvrir'}</h2>
                            <p className="muted">
                                {visibleProperties.length} bien(s) affiché(s)
                                {filters ? ' selon vos critères' : ''}.
                            </p>
                        </div>

                        <button
                            type="button"
                            className={`outline ${favoritesOnly ? 'selected' : ''}`}
                            aria-pressed={favoritesOnly}
                            onClick={() => setFavoritesOnly(!favoritesOnly)}
                        >
                            {favoritesOnly ? 'Voir les résultats' : `♡ Mes favoris (${favorites.length})`}
                        </button>
                    </div>

                    {visibleProperties.length > 0 ? (
                        <div className="cards">
                            {visibleProperties.map((property) => (
                                <article className="card" key={property.id}>
                                    <div className="card-image">
                                        <HouseIllustration color={property.color} />
                                        <span className="badge">
                                            {property.transaction === 'Vente' ? 'À vendre' : 'À louer'}
                                        </span>

                                        <button
                                            type="button"
                                            className={`favorite ${favorites.includes(property.id) ? 'saved' : ''}`}
                                            onClick={() => toggleFavorite(property.id)}
                                            aria-label={`${favorites.includes(property.id) ? 'Retirer des' : 'Ajouter aux'} favoris : ${property.title}`}
                                            aria-pressed={favorites.includes(property.id)}
                                        >
                                            {favorites.includes(property.id) ? '♥' : '♡'}
                                        </button>
                                    </div>

                                    <div className="card-body">
                                        <p className="price">
                                            {money(property.price)} DH
                                            {property.transaction === 'Location' && <small> / mois</small>}
                                        </p>
                                        <h3>{property.title}</h3>
                                        <p className="location">{property.city} · {property.district}</p>
                                        <div className="features">
                                            <span>{property.area} m²</span>
                                            <span>{property.bedrooms} chambres</span>
                                            <span>{property.type}</span>
                                        </div>
                                    </div>
                                </article>
                            ))}
                        </div>
                    ) : (
                        <div className="empty">
                            <p>Aucun bien ne correspond à cette sélection.</p>
                            <button
                                type="button"
                                className="outline"
                                onClick={() => {
                                    setFilters(null);
                                    setFavoritesOnly(false);
                                    setCity('');
                                    setType('');
                                    setBudget('');
                                }}
                            >
                                Afficher tous les biens
                            </button>
                        </div>
                    )}

                    <p className="demo-note">
                        Démonstration : annonces fictives et illustrations.
                        Les favoris sont conservés uniquement pendant cette visite.
                    </p>
                </section>

                <section id="agence" className="about">
                    <div>
                        <p className="eyebrow">L’esprit ImmoSpace</p>
                        <h2>Votre projet immobilier,<br />en toute simplicité.</h2>
                        <p>
                            Nous imaginons une expérience immobilière plus claire,
                            plus humaine et plus proche de vos besoins. Du premier
                            échange à la découverte de votre futur lieu de vie.
                        </p>
                        <a href="#contact" className="text-link">Parlons de votre projet ↗</a>
                    </div>

                    <div className="reasons">
                        <div className="reason">
                            <span className="number">01</span>
                            <div>
                                <strong>Une sélection adaptée</strong>
                                <p>Des biens à explorer selon votre budget et votre mode de vie.</p>
                            </div>
                        </div>
                        <div className="reason">
                            <span className="number">02</span>
                            <div>
                                <strong>Des informations claires</strong>
                                <p>Les caractéristiques essentielles réunies au même endroit.</p>
                            </div>
                        </div>
                        <div className="reason">
                            <span className="number">03</span>
                            <div>
                                <strong>Un accompagnement personnel</strong>
                                <p>Un espace pensé pour faciliter vos prochaines démarches.</p>
                            </div>
                        </div>
                    </div>
                </section>

                <section className="contact" id="contact">
                    <div>
                        <h2>Une nouvelle adresse commence ici.</h2>
                        <p>
                            L’espace de contact sera disponible prochainement
                            pour organiser vos visites.
                        </p>
                    </div>
                    <span className="contact-tag">Projet en développement</span>
                </section>

                <div style={{ height: 60 }} />

                <footer>
                    <a href="#accueil" className="logo">Immo<span>Space.</span></a>
                    <p>© {new Date().getFullYear()} ImmoSpace · Projet réalisé par Inass Silbi</p>
                </footer>
            </div>
        </>
    );
}

createRoot(document.getElementById('app')).render(<App />);